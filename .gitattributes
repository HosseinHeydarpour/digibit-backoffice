# Store LF in the repository and check it out as LF on every platform.
#
# Without this, core.autocrlf=true converts files to CRLF on checkout while
# Prettier (default endOfLine: lf) expects LF — so `prettier --check` flags
# files that git considers unmodified, and the pre-commit hook rewrites them
# back on every commit.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.woff  binary
*.woff2 binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
